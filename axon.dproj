<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{6E2F8B1A-3C4D-4E5F-9A7B-8C1D2E3F4A50}</ProjectGuid>
        <ProjectVersion>20.4</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
        <TargetedPlatforms>2</TargetedPlatforms>
        <AppType>Console</AppType>
        <MainSource>axon.dpr</MainSource>
        <ProjectName Condition="'$(ProjectName)'==''">axon</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Cfg_1)'=='true') or '$(Cfg_1_Win64)'!=''">
        <Cfg_1_Win64>true</Cfg_1_Win64>
        <CfgParent>Cfg_1</CfgParent>
        <Cfg_1>true</Cfg_1>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_DcuOutput>.\$(Platform)\$(Config)\dcu</DCC_DcuOutput>
        <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
        <DCC_Namespace>System;Winapi;Posix;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>src;src\native;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <SanitizedProjectName>axon</SanitizedProjectName>
        <VerInfo_Locale>1033</VerInfo_Locale>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64)'!=''">
        <PostBuildEvent><![CDATA[xcopy /y /d /q "$(MSBuildProjectDirectory)\lib\win64\*.dll" "$(MSBuildProjectDirectory)\$(Platform)\$(Config)\"
xcopy /y /d /q /i "$(MSBuildProjectDirectory)\stdlib\*.sci" "$(MSBuildProjectDirectory)\$(Platform)\$(Config)\stdlib\"
xcopy /y /d /q /i "$(MSBuildProjectDirectory)\stdlib\*.toml" "$(MSBuildProjectDirectory)\$(Platform)\$(Config)\stdlib\"
xcopy /y /d /q /i "$(MSBuildProjectDirectory)\examples\*.sci" "$(MSBuildProjectDirectory)\$(Platform)\$(Config)\examples\"
xcopy /y /d /q /i "$(MSBuildProjectDirectory)\help\*.md" "$(MSBuildProjectDirectory)\$(Platform)\$(Config)\help\"
xcopy /y /d /q /i "$(MSBuildProjectDirectory)\doc\Axon-Language-Reference.md" "$(MSBuildProjectDirectory)\$(Platform)\$(Config)\help\"
xcopy /y /d /q /i "$(MSBuildProjectDirectory)\doc\Axon-White-Paper.md" "$(MSBuildProjectDirectory)\$(Platform)\$(Config)\help\"]]></PostBuildEvent>
        <Manifest_File>(None)</Manifest_File>
        <AppDPIAwarenessMode>none</AppDPIAwarenessMode>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>false</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_RangeChecking>true</DCC_RangeChecking>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_DebugInformation>0</DCC_DebugInformation>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="src\Axon.Version.pas"/>
        <DCCReference Include="src\Axon.Errors.pas"/>
        <DCCReference Include="src\Axon.Platform.pas"/>
        <DCCReference Include="src\Axon.Source.pas"/>
        <DCCReference Include="src\Axon.Tokens.pas"/>
        <DCCReference Include="src\Axon.Lexer.pas"/>
        <DCCReference Include="src\Axon.Ast.pas"/>
        <DCCReference Include="src\Axon.Parser.pas"/>
        <DCCReference Include="src\Axon.AstDump.pas"/>
        <DCCReference Include="src\Axon.Complex.pas"/>
        <DCCReference Include="src\Axon.Values.pas"/>
        <DCCReference Include="src\Axon.Ops.pas"/>
        <DCCReference Include="src\Axon.Builtins.pas"/>
        <DCCReference Include="src\Axon.Interp.pas"/>
        <DCCReference Include="src\Axon.Repl.pas"/>
        <DCCReference Include="src\Axon.Help.pas"/>
        <DCCReference Include="src\Axon.NativeModules.pas"/>
        <DCCReference Include="src\Axon.IoModule.pas"/>
        <DCCReference Include="src\Axon.TimeModule.pas"/>
        <DCCReference Include="src\Axon.Random.pas"/>
        <DCCReference Include="src\Axon.FloatParse.pas"/>
        <DCCReference Include="src\Axon.OdeCore.pas"/>
        <DCCReference Include="src\native\Axon.Native.Cvode.pas"/>
        <DCCReference Include="src\Axon.Graphics.pas"/>
        <DCCReference Include="src\Axon.Packages.pas"/>
        <DCCReference Include="src\Axon.Ffi.pas"/>
        <DCCReference Include="src\Axon.Linalg.pas"/>
        <DCCReference Include="src\native\Axon.Native.Callbacks.pas"/>
        <DCCReference Include="src\native\Axon.Native.Trampolines.pas"/>
        <DCCReference Include="src\Axon.TestRunner.pas"/>
        <DCCReference Include="src\Axon.Cli.pas"/>
        <DCCReference Include="src\native\Axon.Native.Blas.pas"/>
        <DCCReference Include="src\native\Axon.Native.Lapack.pas"/>
        <DCCReference Include="src\Axon.Sparse.pas"/>
        <DCCReference Include="src\Axon.SparseLU.pas"/>
        <DCCReference Include="src\native\Axon.Native.Mir.pas"/>
        <DCCReference Include="src\Axon.JitSelfTest.pas"/>
        <DCCReference Include="src\Axon.Jit.Ir.pas"/>
        <DCCReference Include="src\Axon.Jit.Lower.pas"/>
        <DCCReference Include="src\Axon.Jit.Mir.pas"/>
        <DCCReference Include="src\Axon.Jit.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">axon.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">False</Platform>
                <Platform value="Win64">True</Platform>
                <Platform value="OSX64">False</Platform>
                <Platform value="OSXARM64">False</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
