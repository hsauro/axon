# Delphi build output
/Win32/
/Win64/
/OSX64/
/OSXARM64/
/Linux64/
*.dcu
*.exe
*.map
*.rsm
*.drc

# IDE state
__history/
__recovery/
*.local
*.identcode
*.dsk
*.stat
*.dproj.local
*.res
*.tvsconfig

# IDE build output (the exe itself goes next to axon, in /Win64/)
/ide/Win64/
/ide/OSXARM64/
/ide/OSX64/

# Native test library built by build.cmd
/tests/m09/bin/

# Files tests write and delete (left behind only if a test is interrupted)
_tmp_*
third_party/

# RAD Studio premium styles, copied from the installation by the IDE build
ide/styles/MineShaft_*.style

# Written on every build by tools/AxonBuildInfo.targets
src/Axon.BuildInfo.inc

# The user manual: figures drawn by its examples, the PDF and LaTeX by-products.
doc/manual/figures/
doc/manual/*.pdf
doc/manual/*.aux
doc/manual/*.log
doc/manual/*.toc
doc/manual/*.out
doc/manual/*.fls
doc/manual/*.fdb_latexmk
doc/manual/*.synctex.gz

# The tutorial: lessons written by tools/gen_tutorial.py from help/tutorial*.md,
# the PDF and LaTeX by-products.
doc/tutorial/lessons/
doc/tutorial/figures/
doc/tutorial/*.pdf
doc/tutorial/*.aux
doc/tutorial/*.log
doc/tutorial/*.toc
doc/tutorial/*.out
doc/tutorial/*.fls
doc/tutorial/*.fdb_latexmk
doc/tutorial/*.synctex.gz

# Python bytecode (doc/research scripts)
__pycache__/
