unit Axon.Native.Callbacks;

(* Callbacks from native code into Axon, without libffi.

   A C library needs a plain function pointer for each callback. Instead of
   generating machine code at run time, the interpreter has a fixed pool of
   trampolines compiled into it (Axon.Native.Trampolines, generated by
   tools/gen_trampolines.sh): CallbackSlots per return kind. Each trampoline
   knows its slot number, gathers the raw argument registers, and calls the
   dispatcher here, which decodes the arguments for the slot's signature and
   runs the slot's handler.

   How arguments are found:
   - Win64: argument k is in RCX/RDX/R8/R9 or XMM0-3 for k < 4, chosen by its
     type, and on the stack after that. The trampoline stores the four integer
     registers in the caller's home area, which makes all arguments one
     contiguous array of 8-byte slots, and saves XMM0-3 separately.
   - macOS (ARM64 and x86-64): integer and floating-point arguments are
     numbered separately (x0-x7 / rdi.. and d0-d7 / xmm0-7), so a Pascal
     function taking 8 integers and 8 doubles receives every register
     argument of any signature. Arguments passed on the stack are not
     supported there, which limits a callback to 8 integer (6 on x86-64) and
     8 floating-point arguments.

   A slot whose handler is gone (its extern call returned and it was not kept)
   or that is called from another thread does not run the handler: it reports
   a fault through OnCallbackFault and returns 0. *)

interface

uses
  System.SysUtils;

const
  CallbackSlots = 32;   // per return kind

type
  TArgClass = (acInt, acFloat32, acFloat64);
  TRetKind = (rtInt, rtFloat64, rtFloat32);   // rtInt also covers void and pointers

  { One raw 64-bit value per declared parameter: integer registers as they
    are, float64 bits, or float32 bits in the low 32. }
  TRawArgs = TArray<UInt64>;
  { Runs the Axon side of a callback and returns the raw result bits. It must
    not raise. }
  TCallbackHandler = reference to function(const Args: TRawArgs): UInt64;
  TCallbackFault = reference to procedure(const Msg: string);

  TCallbackResult = record
    Int: UInt64;      // returned in RAX / x0
    Float: UInt64;    // returned in XMM0 / d0 (float32 in the low 32 bits)
  end;
  PCallbackResult = ^TCallbackResult;
  PUInt64Array = ^TUInt64Array;
  TUInt64Array = array[0..1023] of UInt64;

var
  OnCallbackFault: TCallbackFault;

{ Takes a free trampoline for the signature and binds Handler to it. Raises
  ForeignError when the pool is exhausted or the signature cannot be served
  on this platform. Returns the slot. }
function AllocateCallback(const Classes: TArray<TArgClass>; Ret: TRetKind;
  const Handler: TCallbackHandler): Integer;
function CallbackAddress(Slot: Integer): Pointer;
procedure ReleaseCallback(Slot: Integer);
function LiveCallbacks: Integer;

{ Called by the trampolines. Slot numbers run over all return kinds:
  Slot = Ord(RetKind) * CallbackSlots + index. }
procedure DispatchWin64(Slot: Integer; Args, FloatRegs: PUInt64Array; Res: PCallbackResult);
procedure DispatchRegs(Slot: Integer; Ints, Floats: PUInt64Array; Res: PCallbackResult);

implementation

uses
  System.Classes,
  Axon.Errors, Axon.Native.Trampolines;

type
  TSlot = record
    InUse: Boolean;
    Classes: TArray<TArgClass>;
    Handler: TCallbackHandler;
    ThreadId: TThreadID;
  end;

var
  Slots: array[0..3 * CallbackSlots - 1] of TSlot;

const
{$IFDEF CPUX64}
  MaxIntRegs = 6;     // System V x86-64 (unused on Win64)
{$ELSE}
  MaxIntRegs = 8;     // ARM64
{$ENDIF}
  MaxFloatRegs = 8;
  MaxWin64Args = 16;

function AllocateCallback(const Classes: TArray<TArgClass>; Ret: TRetKind;
  const Handler: TCallbackHandler): Integer;
var
  I, Base: Integer;
{$IFNDEF MSWINDOWS}
  NInt, NFloat: Integer;
  C: TArgClass;
{$ENDIF}
begin
{$IFDEF MSWINDOWS}
  if Length(Classes) > MaxWin64Args then
    raise EAxonError.Create(ForeignError, Format(
      'a callback can take at most %d arguments', [MaxWin64Args]));
{$ELSE}
  NInt := 0;
  NFloat := 0;
  for C in Classes do
    if C = acInt then Inc(NInt) else Inc(NFloat);
  if (NInt > MaxIntRegs) or (NFloat > MaxFloatRegs) then
    raise EAxonError.Create(ForeignError, Format(
      'a callback on this platform can take at most %d integer or pointer and %d floating-point arguments',
      [MaxIntRegs, MaxFloatRegs]));
{$ENDIF}
  Base := Ord(Ret) * CallbackSlots;
  for I := Base to Base + CallbackSlots - 1 do
    if not Slots[I].InUse then
    begin
      Slots[I].InUse := True;
      Slots[I].Classes := Copy(Classes);
      Slots[I].Handler := Handler;
      Slots[I].ThreadId := TThread.CurrentThread.ThreadID;
      Exit(I);
    end;
  raise EAxonError.Create(ForeignError, Format(
    'too many live callbacks (the limit is %d per return type)', [CallbackSlots]));
end;

function CallbackAddress(Slot: Integer): Pointer;
begin
  Result := TrampolineAddress(Slot);
end;

procedure ReleaseCallback(Slot: Integer);
begin
  Slots[Slot].InUse := False;
  Slots[Slot].Handler := nil;
  Slots[Slot].Classes := nil;
end;

function LiveCallbacks: Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to High(Slots) do
    if Slots[I].InUse then
      Inc(Result);
end;

procedure Fault(const Msg: string);
begin
  if Assigned(OnCallbackFault) then
    OnCallbackFault(Msg);
end;

{ Runs slot Slot with decoded arguments and stores the result. }
procedure RunSlot(Slot: Integer; const Raw: TRawArgs; Res: PCallbackResult);
var
  Handler: TCallbackHandler;
  R: UInt64;
begin
  Res.Int := 0;
  Res.Float := 0;
  if not Slots[Slot].InUse then
  begin
    Fault('a callback was called after the extern call that created it had returned ' +
      '(use keep(f) for callbacks that native code stores)');
    Exit;
  end;
  if TThread.CurrentThread.ThreadID <> Slots[Slot].ThreadId then
  begin
    Fault('a callback was called from another thread; callbacks must run on the thread that made the extern call');
    Exit;
  end;
  Handler := Slots[Slot].Handler;
  try
    R := Handler(Raw);
  except
    R := 0;
  end;
  case TRetKind(Slot div CallbackSlots) of
    rtInt:     Res.Int := R;
    rtFloat64,
    rtFloat32: Res.Float := R;
  end;
end;

procedure DispatchWin64(Slot: Integer; Args, FloatRegs: PUInt64Array; Res: PCallbackResult);
var
  Raw: TRawArgs;
  P: Integer;
  Classes: TArray<TArgClass>;
begin
  Classes := Slots[Slot].Classes;
  SetLength(Raw, Length(Classes));
  for P := 0 to High(Classes) do
    if (P < 4) and (Classes[P] <> acInt) then
      Raw[P] := FloatRegs[P]
    else
      Raw[P] := Args[P];
  RunSlot(Slot, Raw, Res);
end;

procedure DispatchRegs(Slot: Integer; Ints, Floats: PUInt64Array; Res: PCallbackResult);
var
  Raw: TRawArgs;
  P, NI, NF: Integer;
  Classes: TArray<TArgClass>;
begin
  Classes := Slots[Slot].Classes;
  SetLength(Raw, Length(Classes));
  NI := 0;
  NF := 0;
  for P := 0 to High(Classes) do
    if Classes[P] = acInt then
    begin
      Raw[P] := Ints[NI];
      Inc(NI);
    end
    else
    begin
      Raw[P] := Floats[NF];
      Inc(NF);
    end;
  RunSlot(Slot, Raw, Res);
end;

end.
