/* The dark FMX style for Windows, loaded with TStyleManager.TrySetStyleFromResource
   ('DARKSTYLE'): RAD Studio's premium MineShaft style. The build copies it from
   $(BDSCOMMONDIR)\Styles\Win into styles\ (gitignored, so Embarcadero's style
   files are not in the repository). AxonIDEStylesMac.rc holds the macOS one. */
DARKSTYLE RCDATA "styles\\MineShaft_Win.style"
