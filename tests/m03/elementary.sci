println(sqrt(16), sqrt(2.25), exp(0), log(1), sin(0), cos(0), tan(0))
println(sqrt(-1.0), log(-1.0), log(0.0), asin(2.0), acos(-2.0), acosh(0.5), atanh(2.0))
println(abs(-3), abs(-2.5), abs(3 + 4i), abs(true))
println(floor(2.7), ceil(2.1), round(2.5), round(-2.5), round(2.4999), int(-3.9), int(7), floor(-0.5))
println(real(3 + 4i), imag(3 + 4i), imag(2.0), conj(3 + 4i), conj(5), arg(-1), arg(1))
println(complex(2), complex(1, -1), real(7))
println(min(3, 7), max(3, 7), min(2, 2.5), max(1.0, 0.0/0.0))
println(factorial(0), factorial(5), factorial(20))
println(sqrt(-4 + 0i), sqrt(-1.0 + 0i))
println(abs(exp(log(10.0)) - 10.0) < 1e-12, abs(atan(1.0) * 4 - 3.141592653589793) < 1e-15)
println(abs(sin(1.0)^2 + cos(1.0)^2 - 1.0) < 1e-15, abs(cosh(2.0)^2 - sinh(2.0)^2 - 1.0) < 1e-12)
println(abs(exp(1i * 3.141592653589793) + 1) < 1e-15)
println(abs(asin(sin(0.5)) - 0.5) < 1e-15, abs(acos(cos(0.5)) - 0.5) < 1e-15, abs(tanh(atanh(0.3)) - 0.3) < 1e-15)
println(abs(asinh(sinh(0.7)) - 0.7) < 1e-15, abs(acosh(cosh(0.7)) - 0.7) < 1e-14)
z = 0.5 + 0.25i
println(abs(sin(asin(z)) - z) < 1e-14, abs(cos(acos(z)) - z) < 1e-14, abs(tan(atan(z)) - z) < 1e-14)
println(abs(sinh(asinh(z)) - z) < 1e-14, abs(cosh(acosh(z)) - z) < 1e-14, abs(tanh(atanh(z)) - z) < 1e-14)
println(abs(exp(log(z)) - z) < 1e-14, abs(sqrt(z)^2 - z) < 1e-14, abs(z^2 - z * z) < 1e-14)
println(tanh(1000.0), tanh(-1000.0), exp(1000.0), exp(-1000.0))
println(typeof(sqrt(4)), typeof(sqrt(4 + 0i)), typeof(abs(-2)), typeof(abs(1i)), typeof(round(2.5)))
