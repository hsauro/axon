function build(n: int): list{real}
  var l: list{real}
  var k: int
  l = list list{real} ()
  %0 = count.int 1, 1, n  @6:3
  %1 = 0
L0:
  %2 = ge.int %1, %0
  bt %2, L2
  k = elem.int 1, 1, %1
  %3 = i2r k
  %4 = mul.real %3, 0.5
  l = append l, %4, 1
L1:
  %1 = add.int %1, 1
  jmp L0
L2:
  ret l

function sum_first(n: int): real
  var l: list{real}
  var s: real
  var x: real
  var t: record{xs: list{real}, k: int}
  %0 = call build(n)  @13:7
  l = %0
  %1 = len.int l, 0
  bound 1, %1  @14:12
  %2 = load.real l, 1
  %3 = add.real %2, 1.0
  %4 = len.int l, 0
  bound 1, %4  @14:5
  store.real l, 1, %3
  s = 0.0
  %5 = l
  %6 = len.int %5, 0
  %7 = 0
L0:
  %8 = ge.int %7, %6
  bt %8, L2
  %9 = add.int %7, 1
  x = load.real %5, %9
  s = add.real s, x
L1:
  %7 = add.int %7, 1
  jmp L0
L2:
  clear %5
  t = record record{xs: list{real}, k: int} (l, 2)
  %10 = len.int t.xs, 0
  %11 = field.int t.k
  bound %11, %10  @20:19
  %12 = load.real t.xs, %11
  %13 = add.real s, %12
  %14 = len.int t.xs, 0
  %15 = i2r %14
  %16 = add.real %13, %15
  ret %16

function lit(x: real): list{real}
  %0 = mul.real 2.0, x
  %1 = list list{real} (x, %0)
  ret %1
