function widen(n: int): real
  var total: real
  var i: int
  var t: bool
  var total.2: int
  total = 0.0
  %0 = count.int 1, 1, n  @3:3
  %1 = 0
L0:
  %2 = ge.int %1, %0
  bt %2, L2
  i = elem.int 1, 1, %1
  %3 = i2r i
  total = add.real total, %3
L1:
  %1 = add.int %1, 1
  jmp L0
L2:
  t = true
  bf t, L4
  total.2 = 1
  total.2 = add.int total.2, 1  @9:5
  jmp L3
L4:
L3:
  ret total
