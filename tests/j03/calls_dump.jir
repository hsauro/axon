function sq(x: real): real
  %0 = mul.real x, x
  ret %0

function norm(x: real, y: real): real
  %0 = call sq(x)  @6:15
  %1 = call sq(y)  @6:23
  %2 = add.real %0, %1
  %3 = call.builtin sqrt(%2)  @6:10
  ret %3

function report(n: int): nothing
  %0 = call.builtin floor(2.5)  @10:21
  call.builtin println("n =", n, %0)  @10:3
  %1 = lt.int n, 0
  bf %1, L1
  call.builtin error("negative")  @12:5
L1:
L0:
  ret

function pair(a: int): int, int
  %0 = add.int a, 1  @17:3
  ret a, %0

function use_pair(a: int): int
  var p: int
  var q: int
  [%0, %1] = call pair(a)  @21:12
  p = %0
  q = %1
  %2 = mul.int p, q  @22:3
  ret %2

