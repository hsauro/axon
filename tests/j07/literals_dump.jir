function pair(a: real, b: int): vector{real}
  %0 = i2r b
  %1 = array.vector{real} 2, 1 (a, %0)
  ret %1

function grid(a: real): matrix{real}
  %0 = array.matrix{real} 2, 2 (a, 2.0, 3.0, a)
  ret %0

function ints(n: int): vector{int}
  %0 = add.int n, 1  @10:3
  %1 = array.vector{int} 2, 1 (n, %0)
  ret %1

