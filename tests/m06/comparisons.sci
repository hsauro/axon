A = [1, 2; 3, 4]
println(A > 2)
println(A == [1, 0; 3, 0])
println([1; 2] != 2)
println(not (A > 2))
println((A > 1) and (A < 4))
println((A < 2) or (A > 3))
println(isequal(A, [1, 2; 3, 4]), isequal(A, [1, 2; 3, 5]), isequal([1; 2], [1, 2]), isequal([1, 2], [1.0, 2.0]))
println(isequal(1:3, [1; 2; 3]), all(A > 0), any(A > 3), all(A > 1), any(A > 9))
println(all([]), any([]))
