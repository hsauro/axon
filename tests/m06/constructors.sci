print(zeros(2, 3))
print(ones(2))
print(eye(2))
print(eye(2, 3))
print(linspace(0, 1, 5))
print(linspace(1, 2, 1), length(linspace(0, 1, 0)))
r = rand(3, 4)
[m, n] = size(r)
print(m, n, all(r >= 0.0 and r < 1.0))
print(typeof(rand()), length(rand(7)))
[m, n] = size([1; 2; 3])
print(m, n, size(eye(4), 1), size(zeros(2, 5), 2), length(zeros(2, 5)))
[m, n] = size(5)
print(m, n)
print(zeros(0, 3))
