println(zeros(2, 3))
println(ones(2))
println(eye(2))
println(eye(2, 3))
println(linspace(0, 1, 5))
println(linspace(1, 2, 1), length(linspace(0, 1, 0)))
r = rand(3, 4)
[m, n] = size(r)
println(m, n, all(r >= 0.0 and r < 1.0))
println(typeof(rand()), length(rand(7)))
[m, n] = size([1; 2; 3])
println(m, n, size(eye(4), 1), size(zeros(2, 5), 2), length(zeros(2, 5)))
[m, n] = size(5)
println(m, n)
println(zeros(0, 3))
