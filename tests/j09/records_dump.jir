function grow(s: record{t: real, y: vector{real}, q: P{a: real, n: int}}, h: real): record{t: real, y: vector{real}, q: P{a: real, n: int}}
  %0 = field.real s.t
  %1 = add.real %0, h
  setfield.real s.t, %1
  %2 = len.int s.y, 0
  bound 1, %2  @15:16
  %3 = load.real s.y, 1
  %4 = mul.real %3, 2.0
  %5 = len.int s.y, 0
  bound 1, %5  @15:7
  store.real s.y, 1, %4
  %6 = field.int s.q.n
  %7 = add.int %6, 1  @16:3
  setfield.int s.q.n, %7
  ret s

function area(r: record{w: real, h: real}): real
  %0 = field.real r.w
  %1 = field.real r.h
  %2 = mul.real %0, %1
  ret %2
