function driver(n: int): real
  var b: record{w: real, h: real}
  var q: P{a: real, n: int}
  var s: record{t: real, y: vector{real}, q: P{a: real, n: int}}
  b = record record{w: real, h: real} (2.0, 3.0)
  q = record P{a: real, n: int} (1.5, n)  @22:7
  %0 = call.builtin zeros(n)  @23:19
  %1 = record record{t: real, y: vector{real}, q: P{a: real, n: int}} (0.0, %0, q)
  clear %0
  s = %1
  %2 = call grow(s, 0.5)  @24:7
  s = %2
  %3 = call area(b)  @25:10
  %4 = field.real s.q.a
  %5 = add.real %3, %4
  %6 = len.int s.y, 0
  %7 = i2r %6
  %8 = add.real %5, %7
  ret %8

function kw(x: real): P{a: real, n: int}
  %0 = record P{a: real, n: int} (x, 2)  @29:10
