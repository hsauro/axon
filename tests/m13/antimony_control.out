function(_y, _p)
  S1 = _y[1]
  k1 = _p[1]
  km1 = _p[2]
  k2 = _p[3]
  X0 = _p[4]
  X1 = _p[5]
  _v1 = k1*X0 - km1*S1
  _v2 = k2*S1
  return [_v1; _v2]
end
